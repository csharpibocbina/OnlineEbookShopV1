{
  "Logging": {
    "IsLocal": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Warning", "Microsoft.EntityFrameworkCore": "Warning" }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": { "path": "logs/errors-.log", "rollingInterval": "Day", "restrictedToMinimumLevel": "Error", "retainedFileCountLimit": 30 }
      },
      {
        "Name": "File",
        "Args": { "path": "logs/app-.log", "rollingInterval": "Day", "retainedFileCountLimit": 7 }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": { "Supabase": "" },
  "ApplicationInsights": { "ConnectionString": "" },
  "Jwt": {
    "Issuer": "OnlineEbookShopV1",
    "Audience": "OnlineEbookShopV1Clients",
    "Key": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "RabbitMq": {
    "Enabled": true,
    "Host": "localhost",
    "Port": 5672,
    "User": "guest",
    "Password": "guest",
    "Exchange": "ebookshop.events",
    "AuditQueue": "ebookshop.audit"
  },
  "Stripe": { "SecretKey": "", "WebhookSecret": "" },
  "PayPal": { "ClientId": "", "ClientSecret": "", "Mode": "sandbox", "WebhookId": "" },
  "Cors": { "Origins": [ "http://localhost:5234", "http://localhost:8081" ] },
  "Database": { "AutoMigrate": true },
  "Seed": { "AdminEmail": "", "AdminPassword": "" }
}
