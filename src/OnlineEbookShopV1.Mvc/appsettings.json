{
  "Logging": { "IsLocal": true },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Warning" }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": { "path": "logs/mvc-.log", "rollingInterval": "Day", "retainedFileCountLimit": 7 }
      }
    ]
  },
  "AllowedHosts": "*",
  "Api": { "BaseUrl": "http://localhost:5144" },
  "ApplicationInsights": { "ConnectionString": "" }
}
