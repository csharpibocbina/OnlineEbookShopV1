@using OnlineEbookShopV1.Mvc.Api
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Online Ebook Shop</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="topbar d-none d-md-block">
        <div class="container d-flex justify-content-between">
            <span>Instant ebook downloads &middot; Secure checkout</span>
            <span>
                <a asp-controller="Checkout" asp-action="Orders">My orders</a>
                @if (!AuthCookieStore.IsSignedIn(Context.Request))
                {
                    <span class="mx-2">|</span><a asp-controller="Account" asp-action="Login">Login</a>
                }
            </span>
        </div>
    </div>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">&#128214;</span> Ebook<span>Shop</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
                <div id="nav" class="navbar-collapse collapse">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Catalog" asp-action="Index">Shop</a></li>
                        @if (AuthCookieStore.IsSignedIn(Context.Request))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Checkout" asp-action="Orders">Orders</a></li>
                        }
                        @if (AuthCookieStore.IsAdmin(Context.Request))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Admin</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Users">Users</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Ebooks">Ebooks</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Orders">All orders</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <form class="header-search me-lg-3 mb-2 mb-lg-0" asp-controller="Catalog" asp-action="Index" method="get">
                        <input type="search" name="q" placeholder="Search books or authors" aria-label="Search" />
                        <button type="submit" aria-label="Search">&#128269;</button>
                    </form>
                    <ul class="navbar-nav align-items-lg-center">
                        <li class="nav-item"><a class="nav-link" asp-controller="Cart" asp-action="Index">&#128722; Cart</a></li>
                        @if (AuthCookieStore.IsSignedIn(Context.Request))
                        {
                            <li class="nav-item"><span class="navbar-text me-2 small">@AuthCookieStore.UserEmail(Context.Request)</span></li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-brand" type="submit">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li>
                            <li class="nav-item"><a class="btn btn-sm btn-brand ms-lg-2" asp-controller="Account" asp-action="Register">Register</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main role="main">
        @if (TempData["Error"] is string err)
        {
            <div class="container mt-3"><div class="alert alert-danger">@err</div></div>
        }
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h5>Online Ebook Shop</h5>
                    <p>Discover, buy and read your next favourite book, delivered instantly.</p>
                </div>
                <div class="col-6 col-md-2">
                    <h6>Shop</h6>
                    <ul class="list-unstyled">
                        <li><a asp-controller="Catalog" asp-action="Index">All books</a></li>
                        <li><a asp-controller="Cart" asp-action="Index">Cart</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-2">
                    <h6>Account</h6>
                    <ul class="list-unstyled">
                        <li><a asp-controller="Account" asp-action="Login">Login</a></li>
                        <li><a asp-controller="Checkout" asp-action="Orders">Orders</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6>Payments</h6>
                    <p class="mb-0">Pay securely with Stripe or PayPal.</p>
                </div>
            </div>
            <div class="footer-bottom">&copy; @DateTime.Now.Year Online Ebook Shop</div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
