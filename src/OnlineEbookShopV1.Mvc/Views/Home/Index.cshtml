@model IReadOnlyList<EbookResponse>
@{
    ViewData["Title"] = "Home";
    var stackColors = new[] { "#0e6b83", "#e07a2d", "#4a6fa5" };
    var heroBooks = Model.Take(3).ToList();
}
<section class="hero">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-6">
                <div class="hero-kicker">Explore the books</div>
                <h1>Expand your mind, reading a great book</h1>
                <p>Thousands of pages, zero shipping. Buy your next ebook and start reading in seconds.</p>
                <a class="btn btn-brand btn-lg" asp-controller="Catalog" asp-action="Index">Shop now &rarr;</a>
            </div>
            <div class="col-lg-6">
                <div class="hero-stack">
                    @for (var i = 0; i < heroBooks.Count; i++)
                    {
                        <div class="stack-book" style="background:linear-gradient(145deg,@stackColors[i],#0b2f3d)">@heroBooks[i].Title</div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<section class="feature-strip">
    <div class="container">
        <div class="strip row g-3">
            <div class="col-6 col-lg-3"><div class="feature"><div class="icon">&#9889;</div><div><strong>Instant access</strong><small>Read right after paying</small></div></div></div>
            <div class="col-6 col-lg-3"><div class="feature"><div class="icon">&#128274;</div><div><strong>Secure payment</strong><small>Stripe and PayPal</small></div></div></div>
            <div class="col-6 col-lg-3"><div class="feature"><div class="icon">&#128218;</div><div><strong>Curated library</strong><small>Hand-picked titles</small></div></div></div>
            <div class="col-6 col-lg-3"><div class="feature"><div class="icon">&#127873;</div><div><strong>Daily offers</strong><small>New deals every day</small></div></div></div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section-head">
            <h2>Featured books</h2>
            <a asp-controller="Catalog" asp-action="Index">Explore more &rarr;</a>
        </div>
        @if (ViewBag.Error is string error)
        {
            <div class="alert alert-warning">@error Could not load the catalog. Is the API running?</div>
        }
        else if (Model.Count == 0)
        {
            <p class="text-muted">No books yet. Check back soon.</p>
        }
        <div class="row g-4">
            @foreach (var ebook in Model.Take(8))
            {
                <div class="col-6 col-md-4 col-lg-3"><partial name="_BookCard" model="ebook" /></div>
            }
        </div>
    </div>
</section>

<section class="section band">
    <div class="container">
        <div class="promo">
            <div>
                <h3>Get 25% off all kinds of super selling</h3>
                <p>Fresh reads, great prices. Browse the whole catalog and find your next page-turner.</p>
            </div>
            <a class="btn" asp-controller="Catalog" asp-action="Index">Shop now</a>
        </div>
    </div>
</section>

@if (Model.Count > 8)
{
    <section class="section">
        <div class="container">
            <div class="section-head"><h2>More to read</h2></div>
            <div class="row g-4">
                @foreach (var ebook in Model.Skip(8).Take(4))
                {
                    <div class="col-6 col-md-4 col-lg-3"><partial name="_BookCard" model="ebook" /></div>
                }
            </div>
        </div>
    </section>
}
