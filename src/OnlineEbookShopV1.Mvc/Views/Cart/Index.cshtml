@model CartResponse
@{
    ViewData["Title"] = "Cart";
}
<h1>Shopping cart</h1>
@if (Model.Items.Count == 0)
{
    <p>Your cart is empty.</p>
    <a class="btn btn-primary" asp-controller="Catalog" asp-action="Index">Browse ebooks</a>
}
else
{
    <table class="table">
        <thead><tr><th>Title</th><th>Price</th><th>Qty</th><th>Total</th><th></th></tr></thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.UnitPrice.ToString("C")</td>
                <td>
                    <form asp-action="Update" method="post" class="d-flex gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ebookId" value="@item.EbookId" />
                        <input class="form-control form-control-sm" style="width:5rem" type="number" min="1" name="quantity" value="@item.Quantity" />
                        <button class="btn btn-sm btn-outline-secondary" type="submit">Update</button>
                    </form>
                </td>
                <td>@item.LineTotal.ToString("C")</td>
                <td>
                    <form asp-action="Remove" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ebookId" value="@item.EbookId" />
                        <button class="btn btn-sm btn-outline-danger" type="submit">Remove</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
        <tfoot><tr><th colspan="3">Total</th><th>@Model.Total.ToString("C")</th><th></th></tr></tfoot>
    </table>
    <a class="btn btn-success" asp-controller="Checkout" asp-action="Index">Checkout</a>
}
